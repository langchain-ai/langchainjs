{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "files": ["./env.d.ts", "./vitest-matchers.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2022.Object", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "strictPropertyInitialization": false,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    // tsdown owns dist/: it bundles the JavaScript and substitutes defines such
    // as __PKG_VERSION__. `tsc --build` (the typecheck task) must not emit over
    // it. The declarations still have to land in outDir -- TypeScript maps a
    // referenced project's output back to its source to resolve imports, and
    // the packages' exports maps point at dist/ -- so only the JavaScript is
    // suppressed. Configs whose tsc genuinely emits JavaScript opt out.
    "emitDeclarationOnly": true
  }
}
