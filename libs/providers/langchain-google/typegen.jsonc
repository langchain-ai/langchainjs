{
  "$schema": "https://hntrl.github.io/sparktype/schema.json",
  "specs": {
    "genContent": {
      "path": "src/openapi/generate-content-openapi.json"
    },
    "interactions": {
      "path": "src/openapi/interactions-openapi.json"
    }
  },
  "outputs": [
    {
      "path": "./src/chat_models/api_types/generate_content.ts",
      "format": "typescript",
      "options": {
        "widenEnums": true
      },
      "contents": [
        {
          "namespace": "GenContent",
          "contents": [
            "genContent:SafetySetting",
            "genContent:HarmCategory",
            "genContent:ThinkingConfig",
            "genContent:GenerativeLanguageModality",
            "genContent:SpeechConfig",
            "genContent:VoiceConfig",
            "genContent:MultiSpeakerVoiceConfig",
            "genContent:SpeakerVoiceConfig",
            "genContent:ImageConfig",
            "genContent:Part",
            "genContent:VideoMetadata",
            "genContent:CodeExecutionResult",
            "genContent:ExecutableCode",
            "genContent:Content",
            "genContent:GenerationConfig",
            {
              "namespace": "Tools",
              "contents": [
                "genContent:FunctionDeclaration",
                "genContent:GoogleSearch",
                "genContent:CodeExecution",
                "genContent:UrlContext",
                "genContent:GoogleMaps",
                "genContent:FileSearch",
                "genContent:ComputerUse",
                "genContent:FunctionCallingConfig",
                "genContent:RetrievalConfig",
                "genContent:ToolConfig",
                // mapped as GeminiFunctionSchema
                "genContent:Schema",
                "genContent:LatLng",
                "genContent:Interval",
                "genContent:SearchTypes",
                "genContent:Type",
                "genContent:WebSearch",
                "genContent:ImageSearch"
              ]
            },
            // in/out types
            "genContent:GenerateContentRequest",
            "genContent:SafetyRating",
            "genContent:CitationMetadata",
            "genContent:GroundingMetadata",
            "genContent:GeminiSearchEntryPoint",
            "genContent:GroundingChunk",
            "genContent:RetrievedContext",
            "genContent:GoogleAiGenerativelanguageV1betaGroundingSupport", // what
            "genContent:GoogleAiGenerativelanguageV1betaSegment", // double what
            "genContent:RetrievalMetadata",
            "genContent:GroundingPassageId",
            "genContent:SemanticRetrieverChunk",
            "genContent:AttributionSourceId",
            "genContent:GroundingAttribution",
            "genContent:UrlMetadata",
            "genContent:UrlContextMetadata",
            "genContent:LogprobsResult",
            "genContent:TopCandidates", // also logprobs
            "genContent:LogprobsResultCandidate",
            "genContent:Candidate",
            "genContent:ModalityTokenCount",
            "genContent:UsageMetadata",
            "genContent:PromptFeedback",
            "genContent:GenerateContentResponse",
            "genContent:TranslationConfig",
            "genContent:CitationSource",
            "genContent:Image",
            "genContent:PrebuiltVoiceConfig",
            "genContent:FunctionResponse",
            "genContent:V1mainMediaResolution",
            "genContent:ServiceTier",
            "genContent:Tool",
            "genContent:GroundingChunkCustomMetadata",
            "genContent:Blob",
            "genContent:AudioTranscriptionConfig",
            "genContent:ResponseFormatConfig",
            "genContent:ToolResponse",
            "genContent:SearchEntryPoint",
            "genContent:Web",
            "genContent:ModelStatus",
            "genContent:AudioTranscription",
            "genContent:FileData",
            "genContent:ToolCall",
            "genContent:Maps",
            "genContent:FunctionCall",
            "genContent:McpServer",
            "genContent:AudioResponseFormat",
            "genContent:TextResponseFormat",
            "genContent:FunctionResponsePart",
            "genContent:LanguageAuto",
            "genContent:LanguageHints",
            "genContent:V1mainToolType",
            "genContent:ModelStage",
            "genContent:PlaceAnswerSources",
            "genContent:GroundingChunkStringList",
            "genContent:ImageResponseFormat",
            "genContent:WordInfo",
            "genContent:GoogleSearchRetrieval",
            "genContent:StreamableHttpTransport",
            "genContent:FunctionResponseBlob",
            "genContent:ReviewSnippet",
            "genContent:DynamicRetrievalConfig"
          ]
        }
      ]
    },
    {
      "path": "./src/chat_models/api_types/interactions.ts",
      "format": "typescript",
      "options": {
        "widenEnums": true
      },
      "contents": [
        {
          "namespace": "Interactions",
          "contents": [
            "interactions:Interaction",
            "interactions:AgentInteraction",
            "interactions:ModelInteraction"
          ]
        }
      ]
    }
  ]
}
