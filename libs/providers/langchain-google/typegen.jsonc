                "interactions:Filter",
                "interactions:HybridSearch",
                "interactions:ParallelAISearchConfig",
                "interactions:RagResource",
                "interactions:RagRetrievalConfig",
                "interactions:RagStoreConfig",
                "interactions:Ranking",
                "interactions:RankService",
                "interactions:VertexAISearchConfig"
              ]
            },
            "interactions:Annotation",
            "interactions:AudioContent",
            "interactions:AudioResponseFormat",
            "interactions:CodeExecutionCallStep",
            "interactions:CodeExecutionCallStepArguments",
            "interactions:CodeExecutionResultStep",
            "interactions:Content",
            "interactions:DocumentContent",
            "interactions:EgressRule",
            "interactions:EnvironmentNetworkEgressAllowlist",
            "interactions:FileCitation",
            "interactions:FileContent",
            "interactions:FileSearchCallStep",
            "interactions:FileSearchResultStep",
            "interactions:FindRequest",
            "interactions:FixRequest",
            "interactions:FunctionCallStep",
            "interactions:FunctionResultStep",
            "interactions:GoogleMapsCallStep",
            "interactions:GoogleMapsCallStepArguments",
            "interactions:GoogleMapsResultItem",
            "interactions:GoogleMapsResultPlaces",
            "interactions:GoogleMapsResultStep",
            "interactions:GoogleSearchCallStep",
            "interactions:GoogleSearchCallStepArguments",
            "interactions:GoogleSearchResultItem",
            "interactions:GoogleSearchResultStep",
            "interactions:GroundingToolCount",
            "interactions:HarmCategory",
            "interactions:ImageConfig",
            "interactions:ImageContent",
            "interactions:ImageResponseFormat",
            "interactions:McpServerToolCallStep",
            "interactions:McpServerToolResultStep",
            "interactions:MediaProcessing",
            "interactions:MediaResolution",
            "interactions:ModalityTokens",
            "interactions:ModelOutputStep",
            "interactions:PlaceCitation",
            "interactions:ProcessingCallStep",
            "interactions:ProcessingResultStep",
            "interactions:RetrievalCallStep",
            "interactions:RetrievalResultStep",
            "interactions:RetrievalStepArguments",
            "interactions:ReviewSnippet",
            "interactions:SessionConfig",
            "interactions:SmartTranscriptionMode",
            "interactions:Source",
            "interactions:SpeakerConfig",
            "interactions:SpeechAnnotation",
            "interactions:SpeechConfig",
            "interactions:StaticMediaProcessing",
            "interactions:Status",
            "interactions:TextContent",
            "interactions:TextResponseFormat",
            "interactions:ThinkingLevel",
            "interactions:ThinkingSummaries",
            "interactions:ThoughtContent",
            "interactions:ThoughtStep",
            "interactions:ToolChoiceConfig",
            "interactions:TranscriptionConfig",
            "interactions:TranscriptionMode",
            "interactions:UrlCitation",
            "interactions:UrlContextCallArguments",
            "interactions:UrlContextCallStep",
            "interactions:UrlContextResult",
            "interactions:UrlContextResultStep",
            "interactions:UserInputStep",
            "interactions:VerbatimTranscriptionMode",
            "interactions:VideoConfig",
            "interactions:VideoContent",
            "interactions:VideoResponseFormat",
            "interactions:WordInfo"
          ]
        }
      ]
    }
  ]
}
